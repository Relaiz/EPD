<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeacherScheduleApp.ViewModels"
             xmlns:converters="clr-namespace:TeacherScheduleApp.Converters"
             xmlns:local="clr-namespace:TeacherScheduleApp.Controls"
             xmlns:behaviors="clr-namespace:TeacherScheduleApp.Behaviors"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             x:Class="TeacherScheduleApp.Views.DayView"
             x:DataType="vm:DayViewModel"
             Background="White"
             UseLayoutRounding="True">

	<UserControl.Resources>
		<SolidColorBrush x:Key="WorkingBrush" Color="#FFF5F5F5"/>
		<converters:DayToCanvasLeftConverter x:Key="DayToCanvasLeft"/>
		<converters:DayToColumnWidthConverter x:Key="DayToColumnWidth"/>
		<converters:BoolToBrushConverter
			x:Key="WorkBrush"
			TrueBrush="White"
			FalseBrush="#FFEEEEEE"/>
	</UserControl.Resources>

	<UserControl.KeyBindings>
		<KeyBinding Gesture="Left" Command="{Binding PreviousDayCommand}"/>
		<KeyBinding Gesture="Right" Command="{Binding NextDayCommand}"/>
		<KeyBinding Gesture="Ctrl+T" Command="{Binding TodayCommand}"/>
	</UserControl.KeyBindings>

	<Grid RowDefinitions="Auto,*">
		<Grid Grid.Row="0" Classes="navbar">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="1"
						Orientation="Horizontal"
						Spacing="10"
						VerticalAlignment="Center"
						HorizontalAlignment="Center">
				<Button Classes="nav" Content="←" Command="{Binding PreviousDayCommand}"/>
				<TextBlock FontSize="16"
						   Foreground="Black"
						   VerticalAlignment="Center"
						   Text="{Binding CurrentDate, StringFormat='Den: {0:dd MMM yyyy}'}"/>
				<Button Classes="nav" Content="→" Command="{Binding NextDayCommand}"/>
				<Button Classes="nav" Content="Dnes" Command="{Binding TodayCommand}"/>
			</StackPanel>
		</Grid>

		<ScrollViewer Grid.Row="1"
					  VerticalScrollBarVisibility="Auto"
					  HorizontalScrollBarVisibility="Disabled"
					  Background="White">
			<Grid UseLayoutRounding="True" Background="White">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="60"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<ItemsControl Grid.Column="0"
							  ItemsSource="{Binding Hours}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Rows="24" Columns="1"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border BorderBrush="#DDDDDD"
									BorderThickness="0,0,1,1"
									Height="80"
									Padding="2">
								<TextBlock Text="{Binding}"
										   Foreground="Black"
										   HorizontalAlignment="Right"
										   VerticalAlignment="Center"
										   Margin="0,0,5,0"/>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Grid Grid.Column="1"
					  Background="White"
					  MinHeight="1920"
					  ClipToBounds="True"
					  UseLayoutRounding="True">
					<ItemsControl ItemsSource="{Binding GridCells}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Rows="24" Columns="1"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="Transparent"
										BorderBrush="#DDDDDD"
										BorderThickness="0,0,1,1"
										Height="80"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<local:CalendarPanel x:Name="CalendarCanvas"
										 DaysCount="1"
										 HoursCount="24"
										 Background="Transparent"
										 HorizontalAlignment="Stretch"
										 VerticalAlignment="Stretch">
						<i:Interaction.Behaviors>
							<behaviors:AttachCalendarPanelBehavior/>
						</i:Interaction.Behaviors>
					</local:CalendarPanel>
				</Grid>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>